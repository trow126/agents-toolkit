#!/usr/bin/env sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SKILL_DIR=$(dirname "$SCRIPT_DIR")

if command -v uv >/dev/null 2>&1; then
  exec uv run --project "$SKILL_DIR" refactor-analyze "$@"
fi

PYTHONPATH="$SKILL_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec python -m refactor_analyze.cli "$@"
