# Route for /cross-critic. Values are rows critic-codex, critic-claude-gate, and critic-claude-alt of
# docs/contracts/model-routing.tsv; change both in the same commit.
# CODEX_MODEL / CODEX_EFFORT: the Codex critic, used on every run (codex exec -s read-only).
# CLAUDE_GATE_MODEL: the Claude critic added by --gate (claude -p, read-only tools).
# CLAUDE_ALT_MODEL: replaces CLAUDE_GATE_MODEL when the author (main session) is that model,
#   so that a document is never criticized by the model that wrote it.
# CLAUDE_MAX_BUDGET_USD: spend cap of one Claude critic call.
CODEX_MODEL=gpt-6-astra
CODEX_EFFORT=medium
CLAUDE_GATE_MODEL=fable
CLAUDE_ALT_MODEL=opus
CLAUDE_MAX_BUDGET_USD=5
