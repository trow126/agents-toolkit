{
  "title": "skill-tuneup per-skill result",
  "description": "One element of results[] returned by the Workflow in workflow.md. skill-tuneup record also checks probe count, verdict evidence, candidate ids, and experiment criteria.",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill", "probe_count", "probes", "baseline", "hygiene", "candidates", "audit", "stress", "experiments"],
  "properties": {
    "skill": {"type": "string", "minLength": 1},
    "probe_count": {"type": "integer", "minimum": 3},
    "probes": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusters", "second_layer"],
      "properties": {
        "clusters": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "probes"],
          "properties": {"name": {"type": "string", "minLength": 1}, "probes": {"type": "integer", "minimum": 1}}}},
        "second_layer": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "hygiene": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["kind", "finding", "evidence", "fix"],
      "properties": {
        "kind": {"type": "string", "enum": ["outdated", "contract_gap", "bug", "evidence_error", "other"]},
        "finding": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1},
        "fix": {"type": "string", "minLength": 1}}}},
    "candidates": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "generation_mechanism", "broken_assumption", "mechanism", "predicted_benefit", "failure_condition",
                   "purpose_line", "mechanism_line", "implementation_line"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "generation_mechanism": {"type": "string", "enum": ["assumption_inversion", "structural_transfer", "changed_principle"]},
        "broken_assumption": {"type": "string", "minLength": 1}, "mechanism": {"type": "string", "minLength": 1},
        "predicted_benefit": {"type": "string", "minLength": 1}, "failure_condition": {"type": "string", "minLength": 1},
        "purpose_line": {"type": "string", "minLength": 1}, "mechanism_line": {"type": "string", "minLength": 1},
        "implementation_line": {"type": "string", "minLength": 1}}}},
    "audit": {
      "type": "object", "additionalProperties": false, "required": ["verdicts", "searched"],
      "properties": {
        "verdicts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "verdict", "method", "url", "purpose_match", "mechanism_match", "implementation_match"],
          "properties": {
            "id": {"type": "string"}, "verdict": {"type": "string", "enum": ["KNOWN", "PARTIAL", "NOT_FOUND"]},
            "method": {"type": "string"}, "url": {"type": "string"},
            "purpose_match": {"type": "boolean"}, "mechanism_match": {"type": "boolean"}, "implementation_match": {"type": "boolean"}}}},
        "searched": {"type": "string", "minLength": 1}
      }
    },
    "stress": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "survives", "reason"],
      "properties": {"id": {"type": "string"}, "survives": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}}}},
    "experiments": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_ids", "hypothesis", "criterion", "runs", "judge_prompt", "outputs", "verdict", "verdict_reason"],
      "properties": {
        "candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "hypothesis": {"type": "string", "minLength": 1}, "criterion": {"type": "string", "minLength": 1},
        "runs": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "prompt"],
          "properties": {"label": {"type": "string"}, "prompt": {"type": "string", "minLength": 1}}}},
        "judge_prompt": {"type": "string", "minLength": 1},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "verdict": {"type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "verdict_reason": {"type": "string", "minLength": 1}}}}
  }
}
