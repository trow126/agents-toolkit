#!/usr/bin/env python3
"""break-consensus-cross — run the two divergent workers of /break-consensus --cross (agents-toolkit, D7).

usage:
  break-consensus-cross prepare <brief-file> [--repo DIR]
  break-consensus-cross codex <run-dir> [--dry-run]
  break-consensus-cross collect <run-dir> [--claude FILE]
  break-consensus-cross finish <run-dir>

prepare  copy the brief into a new run directory under
         ${XDG_STATE_HOME:-~/.local/state}/agents-toolkit/break-consensus/, record its sha256, the
         git status of the repository (when there is one), and the hash of the global Codex
         instructions, check divergent-route.env against the Codex catalog, render the worker
         prompt, and print JSON for the Claude main session.
codex    run the Codex worker (from the main session with Bash run_in_background=true):
         codex exec -C <empty temporary directory> --skip-git-repo-check -p toolkit-divergent
         -s read-only -m <model> -c model_reasoning_effort=<effort> --json
         --output-schema divergent.schema.json -o <run>/codex-output.json - < <run>/worker-prompt.md
         then record the model, effort, sandbox, and cwd Codex used (from its session rollout).
collect  validate both outputs (<run>/claude-output.json holds the Claude worker's Workflow result)
         against the schema, the brief hash, the worker prompt, the Codex route and sandbox, and the
         git status, then print both candidate lists.
finish   check <run>/synthesis.md and the git status again, and write <run>/result.md with the
         synthesis and both raw outputs.
Nothing here writes to the repository; the run directory is outside it.
"""
import datetime as dt
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True  # keep the live checkout free of __pycache__
sys.path.insert(0, str(Path(__file__).resolve().parent))
from delegation_common import (  # noqa: E402
    DelegationError, catalog_levels, codex_home, load_json, schema_errors, sha256_file, write_json,
)

TOOLKIT_ROOT = Path(__file__).resolve().parents[2]
REFERENCES = TOOLKIT_ROOT / "shared/skills/break-consensus/references"
ROUTE_FILE = REFERENCES / "divergent-route.env"
SCHEMA_FILE = REFERENCES / "divergent.schema.json"
PROCEDURE = REFERENCES / "cross.md"
PROFILE = "toolkit-divergent"
MAX_BRIEF_BYTES = 64 * 1024
MECHANISMS = ("assumption_inversion", "structural_transfer", "changed_principle")
SECTIONS = ("Agreements", "Differences", "Decisions", "Notes")
SECRET_PATTERNS = (
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"\bgh[pousr]_[A-Za-z0-9]{36,}",
    r"\bgithub_pat_[A-Za-z0-9_]{20,}",
    r"\bsk-[A-Za-z0-9_-]{20,}",
    r"\bxox[abprs]-[A-Za-z0-9-]{10,}",
    r"\bAKIA[0-9A-Z]{16}\b",
)


def now() -> str:
    return dt.datetime.now(dt.UTC).isoformat(timespec="seconds")


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def state_root() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(base) / "agents-toolkit" / "break-consensus"


def pop_option(args: list[str], name: str) -> str | None:
    if name not in args:
        return None
    i = args.index(name)
    value = args[i + 1] if i + 1 < len(args) else ""
    del args[i:i + 2]
    if not value:
        raise DelegationError(f"{name} needs a value")
    return value


# ---------------------------------------------------------------- route, repository, prompt
def read_route() -> dict[str, str]:
    values = {}
    for line in ROUTE_FILE.read_text(encoding="utf-8").splitlines():
        match = re.match(r"^\s*([A-Z_]+)=(.*)$", line)
        if match:
            values[match.group(1)] = match.group(2).strip().strip("\"'")
    missing = [k for k in ("CLAUDE_MODEL", "CODEX_MODEL", "CODEX_EFFORT") if not values.get(k)]
    if missing:
        raise DelegationError(f"{ROUTE_FILE}: missing {', '.join(missing)}")
    return {"claude_model": values["CLAUDE_MODEL"], "codex_model": values["CODEX_MODEL"],
            "codex_effort": values["CODEX_EFFORT"]}


def route_errors(route: dict[str, str]) -> list[str]:
    errors = []
    if not re.fullmatch(r"[a-z][a-z0-9.-]*", route["claude_model"]):
        errors.append(f"CLAUDE_MODEL is not a model alias or id: {route['claude_model']!r}")
    model, effort = route["codex_model"], route["codex_effort"]
    if effort == "ultra":
        errors.append("CODEX_EFFORT ultra is not allowed")
    levels = catalog_levels()
    if not levels:
        errors.append(f"Codex model catalog is unavailable: {codex_home() / 'models_cache.json'}")
    elif model not in levels:
        errors.append(f"CODEX_MODEL {model} is not in the Codex catalog")
    elif effort not in levels[model]:
        errors.append(f"CODEX_EFFORT {effort} is not supported by {model}: {levels[model]}")
    if not (codex_home() / f"{PROFILE}.config.toml").is_file():
        errors.append(f"Codex profile is not installed: {codex_home() / f'{PROFILE}.config.toml'}")
    return errors


def find_repo(start: Path) -> Path | None:
    result = subprocess.run(["git", "-C", str(start), "rev-parse", "--show-toplevel"],
                            capture_output=True, text=True, check=False)
    return Path(result.stdout.strip()).resolve() if result.returncode == 0 else None


def git_state(repo: Path | None) -> dict | None:
    if repo is None:
        return None
    head = subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", "-q", "HEAD"],
                          capture_output=True, text=True, check=False).stdout.strip()
    status = subprocess.run(["git", "-C", str(repo), "status", "--porcelain=v1", "--untracked-files=all"],
                            capture_output=True, text=True, check=False)
    if status.returncode != 0:
        raise DelegationError(f"git status failed in {repo}: {status.stderr.strip()}")
    return {"repo": str(repo), "head": head, "status": [line for line in status.stdout.splitlines() if line]}


def git_unchanged(run: dict) -> tuple[bool, str]:
    before = run.get("git_before")
    if before is None:
        return True, "no repository was recorded at prepare"
    after = git_state(Path(before["repo"]))
    if after == before:
        return True, f"git status and HEAD of {before['repo']} are unchanged"
    return False, f"git status or HEAD of {before['repo']} changed since prepare: before {before}, now {after}"


def prompt_template() -> str:
    text = PROCEDURE.read_text(encoding="utf-8")
    match = re.search(r"^## Worker prompt$.*?^```text\n(.*?)^```$", text, re.M | re.S)
    if not match:
        raise DelegationError(f"{PROCEDURE}: worker prompt template not found")
    return match.group(1)


def global_instructions() -> dict[str, str | None]:
    home = codex_home()
    return {name: (sha256_file(home / name) if (home / name).is_file() else None)
            for name in ("AGENTS.md", "AGENTS.override.md")}


# ---------------------------------------------------------------- prepare
def cmd_prepare(args: list[str]) -> int:
    repo_arg = pop_option(args, "--repo")
    if len(args) != 1:
        raise DelegationError("usage: break-consensus-cross prepare <brief-file> [--repo DIR]")
    brief = Path(args[0]).resolve()
    if not brief.is_file():
        raise DelegationError(f"brief is not a file: {brief}")
    data = brief.read_bytes()
    if not data.strip():
        raise DelegationError("brief is empty")
    if len(data) > MAX_BRIEF_BYTES:
        raise DelegationError(f"brief is larger than {MAX_BRIEF_BYTES} bytes; summarize it")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise DelegationError(f"brief is not UTF-8: {exc}") from exc
    for pattern in SECRET_PATTERNS:
        if re.search(pattern, text):
            raise DelegationError(f"brief looks like it contains a secret (pattern {pattern}); remove it")
    repo = find_repo(Path(repo_arg) if repo_arg else Path.cwd())
    if repo is not None and repo in brief.parents:
        raise DelegationError(f"brief must be outside the repository {repo}")
    route = read_route()
    errors = route_errors(route)
    if errors:
        raise DelegationError("; ".join(errors))

    brief_sha = sha256_bytes(data)
    stamp = dt.datetime.now(dt.UTC).strftime("%Y%m%dT%H%M%SZ")
    root = state_root()
    root.mkdir(parents=True, exist_ok=True)
    for attempt in range(100):
        run_dir = root / (f"{stamp}-{brief_sha[:8]}" + (f"-{attempt}" if attempt else ""))
        try:
            run_dir.mkdir()
            break
        except FileExistsError:
            continue
    else:
        raise DelegationError(f"cannot create a run directory under {root}")
    (run_dir / "brief.md").write_bytes(data)
    prompt = prompt_template().replace("{{BRIEF_SHA256}}", brief_sha).replace("{{BRIEF}}", text.rstrip("\n"))
    (run_dir / "worker-prompt.md").write_text(prompt, encoding="utf-8")
    write_json(run_dir / "run.json", {
        "id": run_dir.name,
        "created_at": now(),
        "brief_sha256": brief_sha,
        "prompt_sha256": sha256_file(run_dir / "worker-prompt.md"),
        "route": route,
        "codex_global_instructions": {"codex_home": str(codex_home()), "sha256": global_instructions()},
        "git_before": git_state(repo),
    })
    print(json.dumps({
        "run_dir": str(run_dir),
        "brief_sha256": brief_sha,
        "claude_model": route["claude_model"],
        "prompt_file": str(run_dir / "worker-prompt.md"),
        "schema_file": str(SCHEMA_FILE),
    }, indent=2))
    return 0


# ---------------------------------------------------------------- codex
def thread_id_of(jsonl: Path) -> str | None:
    try:
        lines = jsonl.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None
    for line in lines:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict) and event.get("type") == "thread.started":
            thread = event.get("thread_id")
            if isinstance(thread, str) and re.fullmatch(r"[0-9A-Za-z-]{8,}", thread):
                return thread
    return None


def rollout_context(thread_id: str | None) -> dict | None:
    """Model, effort, sandbox, and cwd from the turn_context of the Codex session rollout."""
    if not thread_id:
        return None
    matches = sorted((codex_home() / "sessions").glob(f"*/*/*/rollout-*-{thread_id}.jsonl"))
    if not matches:
        return None
    with matches[-1].open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                item = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(item, dict) and item.get("type") == "turn_context":
                payload = item.get("payload") or {}
                sandbox = payload.get("sandbox_policy")
                return {
                    "rollout": str(matches[-1]),
                    "model": payload.get("model"),
                    "effort": payload.get("effort"),
                    "sandbox": sandbox.get("type") if isinstance(sandbox, dict) else sandbox,
                    "cwd": payload.get("cwd"),
                }
    return None


def cmd_codex(args: list[str]) -> int:
    dry_run = "--dry-run" in args
    args = [a for a in args if a != "--dry-run"]
    if len(args) != 1:
        raise DelegationError("usage: break-consensus-cross codex <run-dir> [--dry-run]")
    run_dir = Path(args[0]).resolve()
    run = load_json(run_dir / "run.json")
    if "codex" in run and not dry_run:
        raise DelegationError(f"the Codex worker already ran for {run['id']}; prepare a new run")
    route = run["route"]
    errors = route_errors(route)
    if errors:
        raise DelegationError("; ".join(errors))
    prompt_path = run_dir / "worker-prompt.md"
    prompt = prompt_path.read_bytes()
    if sha256_bytes(prompt) != run["prompt_sha256"]:
        raise DelegationError("worker-prompt.md changed since prepare")
    output = run_dir / "codex-output.json"

    def command(workdir: str) -> list[str]:
        return ["codex", "exec", "-C", workdir, "--skip-git-repo-check", "-p", PROFILE, "-s", "read-only",
                "-m", route["codex_model"], "-c", f"model_reasoning_effort={route['codex_effort']}",
                "--json", "--output-schema", str(SCHEMA_FILE), "-o", str(output), "-"]

    if dry_run:
        print("DRY RUN: " + " ".join(shlex.quote(c) for c in command("<empty temporary directory>"))
              + f" < {prompt_path}")
        return 0
    workdir = Path(tempfile.mkdtemp(prefix="break-consensus-")).resolve()
    empty_before = not any(workdir.iterdir())
    version = subprocess.run(["codex", "--version"], capture_output=True, text=True, check=False).stdout.strip()
    output.unlink(missing_ok=True)
    started = now()
    print(f"[break-consensus-cross] {run['id']}: Codex worker {route['codex_model']}/{route['codex_effort']}"
          f" ({version}) in {workdir}", file=sys.stderr)
    with (run_dir / "codex-exec.jsonl").open("wb") as stdout, (run_dir / "codex-exec.stderr").open("wb") as stderr:
        rc = subprocess.run(command(str(workdir)), input=prompt, stdout=stdout, stderr=stderr, check=False).returncode
    leftovers = sorted(p.name for p in workdir.iterdir())
    shutil.rmtree(workdir, ignore_errors=True)
    thread_id = thread_id_of(run_dir / "codex-exec.jsonl")
    run["codex"] = {
        "cwd": str(workdir), "cwd_empty_before": empty_before, "cwd_leftovers": leftovers,
        "exit_code": rc, "cli_version": version, "prompt_sha256": sha256_bytes(prompt),
        "started_at": started, "finished_at": now(),
        "thread_id": thread_id, "used": rollout_context(thread_id),
    }
    write_json(run_dir / "run.json", run)
    print(f"[break-consensus-cross] codex exec exit {rc}; next: break-consensus-cross collect {run_dir}",
          file=sys.stderr)
    return rc


# ---------------------------------------------------------------- collect
def output_errors(output: dict, schema: dict, brief_sha: str) -> list[str]:
    errors = schema_errors(output, schema)
    if errors:
        return errors
    if output["brief_sha256"] != brief_sha:
        errors.append(f"brief_sha256 {output['brief_sha256']!r} does not match the brief ({brief_sha})")
    if not [b for b in output["consensus_baseline"] if b.strip()]:
        errors.append("consensus_baseline is empty")
    if not output["candidates"]:
        errors.append("no candidates")
    for index, candidate in enumerate(output["candidates"]):
        empty = [k for k, v in candidate.items() if isinstance(v, str) and not v.strip()]
        if empty:
            errors.append(f"candidates[{index}]: empty {', '.join(empty)}")
    return errors


def cmd_collect(args: list[str]) -> int:
    claude_arg = pop_option(args, "--claude")
    if len(args) != 1:
        raise DelegationError("usage: break-consensus-cross collect <run-dir> [--claude FILE]")
    run_dir = Path(args[0]).resolve()
    run = load_json(run_dir / "run.json")
    claude_path = run_dir / "claude-output.json"
    if claude_arg and Path(claude_arg).resolve() != claude_path:
        shutil.copyfile(claude_arg, claude_path)
    schema = json.loads(SCHEMA_FILE.read_text(encoding="utf-8"))
    checks: list[tuple[bool, str]] = []
    outputs: dict[str, dict] = {}

    # Both inputs are the worker prompt fixed at prepare, before either worker ran, so neither
    # worker's input can contain the other's output: the prompt must be unchanged, Codex must have
    # received it, and each output must echo the brief hash that only the prompt carries.
    checks.append((sha256_file(run_dir / "worker-prompt.md") == run["prompt_sha256"],
                   "worker prompt is unchanged since prepare"))
    for name in ("codex", "claude"):
        path = run_dir / f"{name}-output.json"
        try:
            output = load_json(path)
        except DelegationError as exc:
            checks.append((False, f"{name} output: {exc}"))
            continue
        errors = output_errors(output, schema, run["brief_sha256"])
        checks.append((not errors, f"{name} output matches the schema and the brief hash"
                       + (": " + "; ".join(errors) if errors else "")))
        if not errors:
            outputs[name] = output
    codex = run.get("codex")
    if not codex:
        checks.append((False, "the Codex worker has not run"))
    else:
        route = run["route"]
        used = codex.get("used") or {}
        repo = (run.get("git_before") or {}).get("repo")
        checks.append((codex["exit_code"] == 0, f"codex exec exited {codex['exit_code']}"))
        checks.append((codex["prompt_sha256"] == run["prompt_sha256"], "Codex received the prepared worker prompt"))
        checks.append((codex["cwd_empty_before"] and not codex["cwd_leftovers"],
                       f"Codex cwd {codex['cwd']} was an empty temporary directory and stayed empty"
                       + (f" (left: {codex['cwd_leftovers']})" if codex["cwd_leftovers"] else "")))
        checks.append((not repo or not Path(codex["cwd"]).is_relative_to(repo), "Codex cwd is outside the repository"))
        if not used:
            checks.append((False, "cannot confirm the Codex route: no session rollout for thread "
                           f"{codex.get('thread_id')}"))
        else:
            checks.append((used["model"] == route["codex_model"] and used["effort"] == route["codex_effort"],
                           f"Codex used {used['model']}/{used['effort']} (route {route['codex_model']}/{route['codex_effort']})"))
            checks.append((used["sandbox"] == "read-only", f"Codex sandbox was {used['sandbox']}"))
            checks.append((used["cwd"] == codex["cwd"], f"Codex session cwd was {used['cwd']}"))
    checks.append(git_unchanged(run))

    ok = all(passed for passed, _ in checks)
    write_json(run_dir / "collect.json", {
        "ok": ok, "checked_at": now(),
        "checks": [{"ok": passed, "check": message} for passed, message in checks],
        "output_sha256": {name: sha256_file(run_dir / f"{name}-output.json")
                          for name in ("codex", "claude") if (run_dir / f"{name}-output.json").is_file()},
    })
    for passed, message in checks:
        print(f"{'OK' if passed else 'FAIL'}: {message}")
    for name, output in outputs.items():
        used = sorted({c["generation_mechanism"] for c in output["candidates"]})
        print(f"\n== {name}: {len(output['candidates'])} candidates, mechanisms {used}")
        if len(used) < len(MECHANISMS):
            print(f"WARN: {name} did not use all three mechanisms")
        for candidate in output["candidates"]:
            print(f"- [{candidate['generation_mechanism']}] {candidate['title']}")
    print(f"\nCOLLECT OK: {run_dir}; next: write {run_dir / 'synthesis.md'}" if ok else f"\nCOLLECT FAIL: {run_dir}")
    return 0 if ok else 1


# ---------------------------------------------------------------- finish
def section_body(text: str, name: str) -> str | None:
    match = re.search(rf"^## {name}[ \t]*\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return match.group(1).strip() if match else None


def cmd_finish(args: list[str]) -> int:
    if len(args) != 1:
        raise DelegationError("usage: break-consensus-cross finish <run-dir>")
    run_dir = Path(args[0]).resolve()
    run = load_json(run_dir / "run.json")
    collect = load_json(run_dir / "collect.json") if (run_dir / "collect.json").is_file() else {}
    problems = []
    if not collect.get("ok"):
        problems.append("collect has not passed")
    for name, digest in (collect.get("output_sha256") or {}).items():
        if sha256_file(run_dir / f"{name}-output.json") != digest:
            problems.append(f"{name}-output.json changed after collect")
    synthesis_path = run_dir / "synthesis.md"
    synthesis = synthesis_path.read_text(encoding="utf-8") if synthesis_path.is_file() else ""
    if not synthesis:
        problems.append(f"{synthesis_path} is missing or empty")
    for name in SECTIONS:
        body = section_body(synthesis, name)
        if not body:
            problems.append(f"synthesis.md needs a non-empty '## {name}' section")
    unchanged, message = git_unchanged(run)
    if not unchanged:
        problems.append(message)
    if problems:
        for problem in problems:
            print(f"FAIL: {problem}")
        return 1

    codex = run["codex"]
    used = codex["used"]
    raw = {name: (run_dir / f"{name}-output.json").read_text(encoding="utf-8").rstrip("\n") for name in ("codex", "claude")}
    brief = (run_dir / "brief.md").read_text(encoding="utf-8").rstrip("\n")
    instructions = run["codex_global_instructions"]
    read = ", ".join(f"{name} {digest[:12]}" for name, digest in instructions["sha256"].items() if digest) or "none"
    fence = "~~~~"
    result = "\n".join([
        f"# /break-consensus --cross {run['id']}",
        "",
        f"- brief sha256: `{run['brief_sha256']}`",
        f"- Claude worker: `{run['route']['claude_model']}` (Workflow agent(), read-only)",
        f"- Codex worker: `{used['model']}/{used['effort']}`, sandbox `{used['sandbox']}`, cwd `{codex['cwd']}`"
        f" (empty temporary directory), {codex['cli_version']}",
        f"- Codex global instructions in `{instructions['codex_home']}` (sha256 prefix): {read}",
        f"- git status before and after: {message}",
        "",
        synthesis.rstrip("\n"),
        "",
        "## Raw output: Codex",
        "",
        f"{fence}json",
        raw["codex"],
        fence,
        "",
        "## Raw output: Claude",
        "",
        f"{fence}json",
        raw["claude"],
        fence,
        "",
        "## Brief",
        "",
        f"{fence}text",
        brief,
        fence,
        "",
    ])
    (run_dir / "result.md").write_text(result, encoding="utf-8")
    print(f"FINISH OK: {run_dir / 'result.md'}")
    return 0


def main(argv: list[str]) -> int:
    commands = {"prepare": cmd_prepare, "codex": cmd_codex, "collect": cmd_collect, "finish": cmd_finish}
    if len(argv) < 2 or argv[1] not in commands:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        return commands[argv[1]](argv[2:])
    except (DelegationError, OSError, KeyError, json.JSONDecodeError) as exc:
        print(f"BREAK-CONSENSUS-CROSS FAIL: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
