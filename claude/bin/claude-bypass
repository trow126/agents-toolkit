#!/usr/bin/env bash
# claude-bypass — 全プロセス隔離（sandbox-runtime）内でのみ bypassPermissions を許可する launcher
#
# 設計（fail-closed）:
#   1. 環境検証: WSL2（microsoft-standard 署名。WSL1 拒否）かつ非 root。判定は実 /proc/version と
#      実 id -u に固定し、環境変数による差し替えは受け付けない（検証ロジックは lib/bypass-gate.sh）
#   2. machine-local opt-in marker（--enable-this-machine で作成。600・schema・期限付き）を検証
#   3. `@anthropic-ai/sandbox-runtime`（srt）で **Claude Code プロセス全体**（built-in tools・
#      MCP・hooks を含む）を Seatbelt/bubblewrap 境界に収容して起動する。srt 不在なら起動しない
#   4. claude には固定 security profile（~/.claude/bypass-profile.json）を CLI `--settings` で渡す。
#      CLI scope は project/local scope より優先されるため、project 側から sandbox 境界を
#      弱められない。permission の ask/deny rules は scope 間マージのため除去もできない
#
# いずれかが不成立なら bypass せず非ゼロ終了する。これは「意図しない bypass 起動」を防ぐ
# policy gate + 隔離起動 wrapper であり、単体でホスト攻撃者への万能防壁ではない。
#
# 使い方:
#   claude-bypass --enable-this-machine   # 環境検証 + srt 設定生成 + marker 作成（期限 180 日）
#   claude-bypass [claude の引数...]      # 検証成功時のみ srt 内で bypassPermissions 起動
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/bypass-gate.sh
source "$SCRIPT_DIR/lib/bypass-gate.sh"

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/agents-toolkit"
MARKER="$CONF_DIR/bypass-approved"
SRT_SETTINGS="$CONF_DIR/srt-bypass-settings.json"
SRT_TEMPLATE="$SCRIPT_DIR/../srt-bypass-settings.template.json"
BYPASS_PROFILE="$SCRIPT_DIR/../bypass-profile.json"

fail() {
  echo "claude-bypass: $*" >&2
  echo "claude-bypass: bypass せず終了します（fail-closed）。通常の \`claude\` を使用してください。" >&2
  exit 1
}

resolve_srt() {
  if command -v srt >/dev/null 2>&1; then
    echo "srt"
    return 0
  fi
  if npx --no-install @anthropic-ai/sandbox-runtime --help >/dev/null 2>&1; then
    echo "npx --no-install @anthropic-ai/sandbox-runtime"
    return 0
  fi
  return 1
}

if [[ "${1:-}" == "--enable-this-machine" ]]; then
  bypass_env_check /proc/version "$(id -u)" || fail "環境検証に失敗しました"
  resolve_srt >/dev/null || fail "sandbox-runtime が見つかりません。\`npm install -g @anthropic-ai/sandbox-runtime\` を先に実行してください（全プロセス隔離の必須依存）"
  ( umask 077 && mkdir -p "$CONF_DIR" )
  if [[ ! -f "$SRT_SETTINGS" ]]; then
    ( umask 077 && cp "$SRT_TEMPLATE" "$SRT_SETTINGS" )
    echo "claude-bypass: srt 設定を生成しました: $SRT_SETTINGS（allowWrite/network は必要最小から拡張可）"
  fi
  ( umask 077 && printf 'schema=1\nenabled-by=%s\nenabled-at=%s\nexpires=%s\nenvironment=personal WSL2 dev machine (single-user)\n' \
    "$(id -un)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(date -d '+180 days' +%F)" > "$MARKER" )
  echo "claude-bypass: opt-in しました（期限: $(date -d '+180 days' +%F)、marker: $MARKER）"
  echo "claude-bypass: 以後 \`claude-bypass\` が sandbox-runtime 隔離内で bypassPermissions 起動します"
  exit 0
fi

bypass_env_check /proc/version "$(id -u)" || fail "環境検証に失敗しました"
bypass_marker_check "$MARKER" "$(id -u)" || fail "opt-in marker の検証に失敗しました"
SRT_BIN="$(resolve_srt)" || fail "sandbox-runtime が見つかりません。\`npm install -g @anthropic-ai/sandbox-runtime\` を実行してください"
[[ -f "$SRT_SETTINGS" ]] || fail "srt 設定がありません（$SRT_SETTINGS）。\`claude-bypass --enable-this-machine\` を再実行してください"
[[ -f "$BYPASS_PROFILE" ]] || fail "固定 security profile がありません（$BYPASS_PROFILE）"

# srt が Claude Code プロセス全体（tools・MCP・hooks）を FS/network 境界へ収容し、
# claude 側は CLI --settings の固定 profile で sandbox 設定と ask gate を pin する
exec $SRT_BIN --settings "$SRT_SETTINGS" claude --permission-mode bypassPermissions --settings "$BYPASS_PROFILE" "$@"
