{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Agent",
      "Bash(bun *)",
      "Bash(cat *)",
      "Bash(curl *)",
      "Bash(echo *)",
      "Bash(env PYTHONDONTWRITEBYTECODE=1 UV_CACHE_DIR=/tmp/uv-cache uv run *)",
      "Bash(env UV_CACHE_DIR=/tmp/uv-cache uv run *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(pwd)",
      "Bash(rm -f /tmp/*)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(touch *)",
      "Bash(uv run *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "deny": [
      "Bash(> /dev/sd*)",
      "Bash(bash *)",
      "Bash(cat **/.env*)",
      "Bash(cat .env*)",
      "Bash(dd if=*of=/dev/sd*)",
      "Bash(git checkout -- .)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(rm -rf .)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf data*)",
      "Bash(rm -rf models*)",
      "Bash(rm -rf results*)",
      "Bash(rm -rf ~)",
      "Bash(sudo *)",
      "Bash(uv run python scripts/scraping/*)",
      "Bash(uv run python scripts/voting/*)",
      "Bash(wget *)",
      "Edit(**/.env*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials.json)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Read(**/service-account*.json)",
      "Read(./.env.*)",
      "Read(.env)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.gem/credentials)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)",
      "Bash(head **/.env*)",
      "Bash(head .env*)",
      "Bash(tail **/.env*)",
      "Bash(tail .env*)",
      "Bash(less **/.env*)",
      "Bash(less .env*)",
      "Bash(more **/.env*)",
      "Bash(more .env*)",
      "Bash(grep * **/.env*)",
      "Bash(grep * .env*)",
      "Bash(awk * **/.env*)",
      "Bash(awk * .env*)",
      "Bash(sed * **/.env*)",
      "Bash(sed * .env*)",
      "Bash(python **/.env*)",
      "Bash(python3 **/.env*)",
      "Bash(node **/.env*)",
      "Bash(cp **/.env*)",
      "Bash(mv **/.env*)",
      "Bash(source **/.env*)",
      "Bash(source .env*)",
      "Bash(. **/.env*)",
      "Bash(. .env*)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Edit(.git/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/config-change-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/slack-notify-hook.sh notification",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-compact-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-review-hook.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/test-quality-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-bash-validate-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-init-hook.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/slack-notify-hook.sh stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "session-report@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "kaggle-skill@shepsci": false,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "shepsci": {
      "source": {
        "source": "github",
        "repo": "shepsci/claude-marketplace"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": false,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "allowRead": [
        "~/.config/gh"
      ]
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "disableAutoMode": "disable",
  "theme": "light-ansi",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": false,
  "autoMode": {
    "environment": [
      "Personal development environment on WSL2",
      "Trusted source control is limited to the git repository where the session starts and its configured remotes",
      "Routine work is local Python ML/data projects and Solidity DeFi projects inside the session repository",
      "Do not treat all repositories under ~/ as automatically trusted; moving into another repository or home-level config is scope escalation unless the user explicitly asks"
    ]
  },
  "model": "claude-fable-5",
  "effortLevel": "high",
  "autoCompactEnabled": true,
  "autoMemoryEnabled": true,
  "skillOverrides": {
    "gh:coderabbit": "off",
    "progress-tracker": "off",
    "issue-retrospective": "off",
    "issue-parser": "off",
    "issue-work-logger": "off",
    "introspect": "off",
    "token-efficiency": "off",
    "x-article-to-markdown": "off"
  }
}
