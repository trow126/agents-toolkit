{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Agent",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh auth status)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(git add *)",
      "Bash(git branch --list *)",
      "Bash(git branch --list)",
      "Bash(git branch)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(rm -f /tmp/*)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(touch *)",
      "Bash(uv run mypy *)",
      "Bash(uv run pytest *)",
      "Bash(uv run pytest)",
      "Bash(uv run ruff *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Edit(**)",
      "Read(**)",
      "WebFetch(domain:agentskills.io)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(> /dev/sd*)",
      "Bash(bash *)",
      "Bash(cat **/.env*)",
      "Bash(cat .env*)",
      "Bash(dd if=*of=/dev/sd*)",
      "Bash(git checkout -- .)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(rm -rf .)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf data*)",
      "Bash(rm -rf models*)",
      "Bash(rm -rf results*)",
      "Bash(rm -rf ~)",
      "Bash(sudo *)",
      "Bash(uv run python scripts/scraping/*)",
      "Bash(uv run python scripts/voting/*)",
      "Bash(wget *)",
      "Edit(**/.env*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials.json)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Read(**/service-account*.json)",
      "Read(./.env.*)",
      "Read(.env)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.gem/credentials)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)",
      "Bash(head **/.env*)",
      "Bash(head .env*)",
      "Bash(tail **/.env*)",
      "Bash(tail .env*)",
      "Bash(less **/.env*)",
      "Bash(less .env*)",
      "Bash(more **/.env*)",
      "Bash(more .env*)",
      "Bash(grep * **/.env*)",
      "Bash(grep * .env*)",
      "Bash(awk * **/.env*)",
      "Bash(awk * .env*)",
      "Bash(sed * **/.env*)",
      "Bash(sed * .env*)",
      "Bash(python **/.env*)",
      "Bash(python3 **/.env*)",
      "Bash(node **/.env*)",
      "Bash(cp **/.env*)",
      "Bash(mv **/.env*)",
      "Bash(source **/.env*)",
      "Bash(source .env*)",
      "Bash(. **/.env*)",
      "Bash(. .env*)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Edit(.git/**)"
    ],
    "defaultMode": "default",
    "ask": [
      "Bash(bunx *)",
      "Bash(curl *)",
      "Bash(gh api *)",
      "Bash(gh gist *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr review *)",
      "Bash(gh release *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo fork *)",
      "Bash(gh run cancel *)",
      "Bash(gh run rerun *)",
      "Bash(gh workflow *)",
      "Bash(git branch -D *)",
      "Bash(git branch -M *)",
      "Bash(git branch -d *)",
      "Bash(git branch -m *)",
      "Bash(git branch --delete *)",
      "Bash(git branch --force *)",
      "Bash(git checkout *)",
      "Bash(git commit --amend*)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(npm access *)",
      "Bash(npm adduser*)",
      "Bash(npm deprecate *)",
      "Bash(npm dist-tag *)",
      "Bash(npm exec *)",
      "Bash(npm login*)",
      "Bash(npm owner *)",
      "Bash(npm publish *)",
      "Bash(npm token *)",
      "Bash(npm unpublish *)",
      "Bash(npm x *)",
      "Bash(npx *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm publish *)"
    ],
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/config-change-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/slack-notify-hook.sh notification",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-compact-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-review-hook.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-bash-validate-hook.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-init-hook.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/slack-notify-hook.sh stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "session-report@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "kaggle-skill@shepsci": false,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "shepsci": {
      "source": {
        "source": "github",
        "repo": "shepsci/claude-marketplace"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.config",
        "~/.local/state",
        "~/.local/share",
        "~/.cache",
        "~/.claude",
        "~/.claude.json",
        "~/.codex",
        "~/.agents"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        },
        {
          "path": "~/.pypirc",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "HF_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "gh *"
    ]
  },
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "theme": "light-ansi",
  "editorMode": "vim",
  "autoMode": {
    "environment": [
      "Personal development environment on WSL2",
      "Trusted source control is limited to the git repository where the session starts and its configured remotes",
      "Routine work is local Python ML/data projects and Solidity DeFi projects inside the session repository",
      "Do not treat all repositories under ~/ as automatically trusted; moving into another repository or home-level config is scope escalation unless the user explicitly asks"
    ]
  },
  "model": "sonnet",
  "effortLevel": "medium",
  "autoCompactEnabled": true,
  "autoMemoryEnabled": true
}
